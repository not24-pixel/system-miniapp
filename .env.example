# TELEGRAM_BOT_TOKEN: Токен бота от @BotFather (заполняется автоматически через start.bat или в Cloudflare Dashboard)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_PLACEHOLDER"

# ADMIN_TELEGRAM_ID: Числовой Telegram ID администратора (узнать в @userinfobot)
ADMIN_TELEGRAM_ID="0"

# APP_URL: Ссылка на ваш Mini App после деплоя на Cloudflare Pages (например https://systema-miniapp.pages.dev)
APP_URL="https://your-miniapp-domain.pages.dev"

# TELEGRAM_WEBHOOK_SECRET: Секретный токен для защиты webhook (опционально)
TELEGRAM_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET_PLACEHOLDER"

# SYSTEMA_PLUS_PRICE_STARS: Базовая цена 1 месяца Системы+ в Telegram Stars (XTR)
SYSTEMA_PLUS_PRICE_STARS="99"

# VITE_BOT_API_URL: Оставьте пустым, если используете Cloudflare Pages Functions (/functions/api/...) на том же домене
VITE_BOT_API_URL=""
